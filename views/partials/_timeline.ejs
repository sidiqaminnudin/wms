<div class="timeline" aria-label="<%= locals.label || 'Linimasa aktivitas' %>">
  <% (locals.items ?? []).forEach(item => { %><div class="timeline-item"><div class="bullet<%= item.status ? ` ${item.status}` : '' %>" aria-hidden="true"></div><div><strong><%= item.title %></strong><% if (item.meta) { %><div class="text-muted"><%= item.meta %></div><% } %><% if (item.description) { %><div><%= item.description %></div><% } %></div></div><% }) %>
</div>

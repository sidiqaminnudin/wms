<div class="toast align-items-center border-0" role="status" aria-live="polite" aria-atomic="true" data-bs-autohide="<%= locals.autohide === false ? 'false' : 'true' %>">
  <div class="d-flex">
    <div class="toast-body<%= locals.variant ? ` text-${locals.variant}` : '' %>"><% if (locals.title) { %><strong class="d-block"><%= locals.title %></strong><% } %><%= locals.message %></div>
    <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Tutup"></button>
  </div>
</div>

<%- include('../partials/head', { bodyClass: 'auth' }) %>
<section class="auth-card">
  <div class="auth-left">
    <div class="logo"><div class="logo-mark"></div><div><div>WMS<br>SJLM &amp; GEKA</div><small>Warehouse Management System</small></div></div>
    <div style="margin-top:48px;max-width:420px">
      <h1 style="font-size:40px;line-height:1.05;margin:0 0 16px">Sistem manajemen gudang yang terintegrasi.</h1>
      <p style="line-height:1.7;opacity:.96">Kelola stok real-time, proses barang lebih cepat, dan data operasional gudang lebih rapi dalam satu platform.</p>
      <div class="list" style="margin-top:24px">
        <div class="list-item" style="background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.18);color:#fff"><div class="mini"><i class="bi bi-check-lg"></i></div><div><strong>Pengelolaan stok real-time</strong></div></div>
        <div class="list-item" style="background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.18);color:#fff"><div class="mini"><i class="bi bi-check-lg"></i></div><div><strong>Proses barang lebih cepat</strong></div></div>
        <div class="list-item" style="background:rgba(255,255,255,.12);border-color:rgba(255,255,255,.18);color:#fff"><div class="mini"><i class="bi bi-check-lg"></i></div><div><strong>Data aman dan terpercaya</strong></div></div>
      </div>
    </div>
  </div>
  <div class="auth-right">
    <div class="logo" style="color:var(--text)"><div class="logo-mark"></div><div><div>WMS<br>SJLM &amp; GEKA</div><small style="color:var(--muted)">Login username &amp; password</small></div></div>
    <div style="margin-top:34px"><h2 style="margin:0 0 10px;font-size:34px">Selamat Datang</h2><p style="color:var(--muted);margin:0 0 24px">Masuk ke WMS SJLM &amp; GEKA untuk melanjutkan.</p></div>
    <form id="loginForm" novalidate>
      <div class="input-group"><label for="username">Username</label><input id="username" name="username" placeholder="Masukkan username" required autocomplete="username"></div>
      <div class="input-group"><label for="password">Password</label><input id="password" name="password" type="password" placeholder="Masukkan password" required autocomplete="current-password"></div>
      <button class="btn btn-primary" style="width:100%;margin-top:8px" type="submit">Masuk</button>
      <p id="loginStatus" class="notice" role="alert" hidden></p>
    </form>
    <div class="notice" style="margin-top:18px">Gunakan akun yang dibuat administrator. Sesi dilindungi cookie HttpOnly dan CSRF token.</div>
    <script src="/public/js/login.js"></script>
  </div>
</section>
</body></html>
